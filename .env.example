# ---------------------------------------------------------------------------
# Supabase → Project → Connect (top bar) → "Connection string"
# Leave DATABASE_URL empty to run an in-memory Postgres with demo data (local dev only).
# ---------------------------------------------------------------------------

# Used by the API. "Transaction pooler" string (port 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Used only by `npm run db:migrate` and `npm run seed`. "Session pooler" string (port 5432).
# DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174

PORT=4000

# Password given to every seeded demo account
SEED_PASSWORD=Aznar@2026
