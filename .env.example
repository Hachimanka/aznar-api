# Leave MONGODB_URI empty to run an in-memory MongoDB with demo data (local dev only).
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aznar
MONGODB_URI=

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174

PORT=4000

# Password given to every seeded demo account (npm run seed / in-memory dev)
SEED_PASSWORD=Aznar@2026
